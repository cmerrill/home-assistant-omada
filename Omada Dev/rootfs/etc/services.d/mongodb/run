#!/usr/bin/with-contenv bashio

bashio::log.info "Starting internal MongoDB..."

DATA_DIR="/opt/tplink/EAPController/data/db"
LOG_DIR="/opt/tplink/EAPController/logs"

mkdir -p "$DATA_DIR" "$LOG_DIR"
chown -R 508:508 "$DATA_DIR" "$LOG_DIR"

# WiredTiger's cache defaults to ~50% of system RAM if left unset, which is
# the original/upstream behavior. Only cap it if the user opts in, so
# existing installs see no change unless they explicitly ask for less.
MONGOD_ARGS=(
  --dbpath "$DATA_DIR" --port 27217 --bind_ip 127.0.0.1
  --logpath "$LOG_DIR/mongod.log" --logappend
)
if bashio::config.has_value 'mongodb_wiredtiger_cache_size_gb'; then
  MONGOD_ARGS+=(--wiredTigerCacheSizeGB "$(bashio::config 'mongodb_wiredtiger_cache_size_gb')")
fi

exec gosu 508:508 mongod "${MONGOD_ARGS[@]}"
